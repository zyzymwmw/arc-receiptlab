{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@receiptlab/core": ["./packages/receipt-core/src/index.ts"],
      "@receiptlab/core/rpc": ["./packages/receipt-core/src/rpc.ts"]
    }
  },
  "include": [
    "apps/web/src",
    "packages/receipt-core/src",
    "packages/receipt-core/test",
    "examples",
    "scripts",
    "tests",
    "*.ts",
    "apps/web/vite.config.ts"
  ]
}
